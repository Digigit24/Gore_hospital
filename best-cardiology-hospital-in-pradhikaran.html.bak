    <style>
        .call-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 14px 22px;
            font-size: 16px;
            font-weight: 600;
            color: #fff;
            text-decoration: none;
            border-radius: 8px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
        }

        .book-btn {
            background-color: #1e88e5;
        }

        .emergency-btn {
            background-color: #d32f2f;
        }

        /* Doctor Card Styles */
        :root {
            --text: #1f1f25;
            --muted: #5b5b63;
            --card-bg: #ffffff;
            --card-bd: rgba(0, 0, 0, 0.06);
            --soft: 0 6px 24px rgba(0, 0, 0, 0.06);
            --soft-2: 0 12px 32px rgba(0, 0, 0, 0.07);
        }

        .doc-card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            height: 100%;
            border: 1px solid rgba(0, 0, 0, 0.02);
        }

        .doc-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

        .doc-photo {
            position: relative;
            width: 100%;
            aspect-ratio: 1 / 1;
            background: #f8f9fa;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .doc-photo img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center;
            display: block;
            transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .doc-card:hover .doc-photo img {
            transform: scale(1.08);
        }

        .doc-body {
            padding: 24px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 6px;
            flex-grow: 1;
            background: #fff;
        }

        .doc-name {
            font-weight: 500;
            font-size: 19px;
            line-height: 1.3;
            margin: 0;
            color: #1a202c;
        }

        .doc-spec {
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #007bff;
            margin-top: 2px;
        }

        .hospital-card {
            border-radius: 10px;
            overflow: hidden;
            background: #ffffff;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
            border: 1px solid rgba(0, 138, 191, 0.08);
            transition: all 0.25s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .hospital-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.12);
            border-color: rgba(0, 138, 191, 0.4);
        }

        .hospital-card .service-card-image img {
            width: 100%;
            height: 210px;
            object-fit: cover;
            transition: transform 0.35s ease;
            padding: 20px;
            border-radius: 30px;
        }

        .banner-video-wrapper {
            position: relative;
            overflow: hidden;
            min-height: 750px;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }

        .banner-bg-video {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            object-fit: cover;
            z-index: -2;
        }

        .banner-video-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(180deg, rgba(2, 167, 233, 0.2) 0%, rgba(0, 0, 0, 0.75) 100%);
            z-index: -1;
        }

        .banner-content-area {
            text-align: left;
            position: relative;
            z-index: 5;
            width: 100%;
            padding: 0 15px;
        }

        .problem-card {
            background: #fff;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            border-left: 5px solid #007bff;
            height: 100%;
            transition: all 0.3s ease;
        }

        .problem-card:hover {
            transform: translateX(10px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

        .problem-card h3 {
            font-size: 20px;
            margin-bottom: 12px;
            color: #0c3459;
        }

        .problem-card p {
            font-size: 15px;
            color: #555;
            line-height: 1.6;
        }
    </style>
</head>

